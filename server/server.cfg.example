# Copy values into your local server.cfg. Never commit license keys or passwords.
set onesync on
set sv_stateBagStrictMode true
set cnr_maintenance_mode 0
set cnr_schema_minimum "20260716001400"
set cnr_registration_enabled 1
set cnr_whitelist_mode "open"
set cnr_identifier_pepper "replace-with-at-least-32-random-characters"
set cnr_spawn_default_x "215.76"
set cnr_spawn_default_y "-810.12"
set cnr_spawn_default_z "30.73"
set cnr_spawn_default_heading "157.0"
set cnr_inventory_character_slots 24
set cnr_inventory_character_weight_grams 30000
set cnr_inventory_storage_slots 48
set cnr_inventory_storage_weight_grams 100000
set cnr_inventory_locker_x "215.76"
set cnr_inventory_locker_y "-810.12"
set cnr_inventory_locker_z "30.73"
set cnr_inventory_locker_radius "4.0"
set cnr_inventory_document_show_radius "3.0"
set cnr_banking_atm_radius "2.5"
set cnr_banking_atm_admin_radius "8.0"
set mysql_connection_string "mysql://cnr_runtime:replace-locally@127.0.0.1:3307/cnr_development?charset=utf8mb4"

ensure oxmysql
ensure spawnmanager
# Do not ensure basic-gamemode; CNR owns every pre-game and controlled spawn transition.
ensure cnr_database
ensure cnr_logs
ensure cnr_locales
ensure cnr_config
ensure cnr_core
ensure cnr_accounts
ensure cnr_permissions
ensure cnr_whitelist
ensure cnr_sessions
ensure cnr_registration
ensure cnr_characters
ensure cnr_items
ensure cnr_inventory
ensure cnr_banking
# Keep cnr_ui as the only active loadscreen resource.
ensure cnr_ui
