# Local development only. Copy to .env and replace every placeholder locally.
COMPOSE_PROJECT_NAME=cnr-dev
CNR_DB_HOST=127.0.0.1
CNR_DB_PORT=3307
CNR_DB_NAME=cnr_development
CNR_DB_TEST_NAME=cnr_test
CNR_DB_RUNTIME_USER=cnr_runtime
CNR_DB_RUNTIME_PASSWORD=replace-with-local-runtime-password
CNR_DB_MIGRATION_USER=cnr_migration
CNR_DB_MIGRATION_PASSWORD=replace-with-local-migration-password
MARIADB_ROOT_PASSWORD=replace-with-local-root-password
DATABASE_URL=mysql://cnr_migration:replace-with-local-migration-password@127.0.0.1:3307/cnr_development
TEST_DATABASE_URL=mysql://cnr_migration:replace-with-local-migration-password@127.0.0.1:3307/cnr_test
DBMATE_MIGRATIONS_DIR=database/migrations
DBMATE_SCHEMA_FILE=database/schema.sql
